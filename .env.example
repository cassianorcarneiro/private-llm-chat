# Required ---------------------------------------------------------------------
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=change-me

# Optional ---------------------------------------------------------------------
# Host port (bound to 127.0.0.1 only).
APP_PORT=8088
# Ollama on the host. Must listen on an address the container can reach.
OLLAMA_BASE_URL=http://host.docker.internal:11434
TIMEZONE=America/Sao_Paulo

# Context window sent to Ollama, capped by each model's own limit.
# KV cache grows with this value: on a 16 GB GPU, 8192-16384 is a sane range.
DEFAULT_NUM_CTX=8192
KEEP_ALIVE=15m

# Embedding model for ranking web passages. Falls back to lexical ranking if absent.
# Install with: ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text

# Model descriptions
CATALOG_ENABLED=true
# Fetch the model's public page to ground the description (only the model name leaves).
CATALOG_FETCH_REMOTE=true
# Empty = use whatever model is already loaded, else the model being described.
DESCRIBER_MODEL=
DESCRIPTION_LANGUAGE=English
